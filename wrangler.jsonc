{
  // Cloudflare Worker that serves the generated Nuxt site and the short links.
  "name": "sunken-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  }
}
