ag":33,"props":182,"children":183},{},[184,186,189],{"type":24,"value":185},"Who is this “you”?",{"type":17,"tag":39,"props":187,"children":188},{},[],{"type":24,"value":190},"\n(well for one, “you”, could be my mother)",{"type":17,"tag":33,"props":192,"children":193},{},[194,196,199],{"type":24,"value":195},"or you could also be my",{"type":17,"tag":39,"props":197,"children":198},{},[],{"type":24,"value":200},"\nex-friend/ex-mentor/ex-romance/deus ex machina",{"type":17,"tag":33,"props":202,"children":203},{},[204,206,209],{"type":24,"value":205},"who apparated and rescued me from",{"type":17,"tag":39,"props":207,"children":208},{},[],{"type":24,"value":210},"\nmyself, by which I always mean, loneliness,",{"type":17,"tag":33,"props":212,"children":213},{},[214,216,225,228],{"type":24,"value":215},"— ",{"type":17,"tag":68,"props":217,"children":218},{},[219],{"type":17,"tag":220,"props":221,"children":222},"strong",{},[223],{"type":24,"value":224},"Bz-Bzzz",{"type":17,"tag":39,"props":226,"children":227},{},[],{"type":24,"value":229},"\nI spent all morning talking to you,",{"type":17,"tag":33,"props":231,"children":232},{},[233,235,238],{"type":24,"value":234},"pacing around the house",{"type":17,"tag":39,"props":236,"children":237},{},[],{"type":24,"value":239},"\nlike the inside of a holding cell,",{"type":17,"tag":33,"props":241,"children":242},{},[243,245,248],{"type":24,"value":244},"(from which, tried as I have, believe me, there is",{"type":17,"tag":39,"props":246,"children":247},{},[],{"type":24,"value":249},"\nno escape, hence the talking to myself,)",{"type":17,"tag":33,"props":251,"children":252},{},[253,255,258],{"type":24,"value":254},"or maybe “you” are your own crisis",{"type":17,"tag":39,"props":256,"children":257},{},[],{"type":24,"value":259},"\njust two time zones away",{"type":17,"tag":33,"props":261,"children":262},{},[263,265,268],{"type":24,"value":264},"just wanting to be held the way",{"type":17,"tag":39,"props":266,"children":267},{},[],{"type":24,"value":269},"\npainters sometimes beheld their subjects,",{"type":17,"tag":33,"props":271,"children":272},{},[273,275,278],{"type":24,"value":274},"which is to say, like snow,",{"type":17,"tag":39,"props":276,"children":277},{},[],{"type":24,"value":279},"\nthe way some pianists can hold a note,",{"type":17,"tag":33,"props":281,"children":282},{},[283,285,288],{"type":24,"value":284},"long and dark as winter nights",{"type":17,"tag":39,"props":286,"children":287},{},[],{"type":24,"value":289},"\nbut soft and warm like hope,",{"type":17,"tag":33,"props":291,"children":292},{},[293,295,298],{"type":24,"value":294},"or maybe you were the boy",{"type":17,"tag":39,"props":296,"children":297},{},[],{"type":24,"value":299},"\nwho went after me in the piano competition,",{"type":17,"tag":33,"props":301,"children":302},{},[303,305,308],{"type":24,"value":304},"who drew me into the ground,",{"type":17,"tag":39,"props":306,"children":307},{},[],{"type":24,"value":309},"\nand afterwards, drew me. Into the ground.",{"type":17,"tag":33,"props":311,"children":312},{},[313,321,323,326],{"type":17,"tag":68,"props":314,"children":315},{},[316],{"type":17,"tag":220,"props":317,"children":318},{},[319],{"type":24,"value":320},"BZ-BZZZ",{"type":24,"value":322}," — oh,",{"type":17,"tag":39,"props":324,"children":325},{},[],{"type":24,"value":327},"\ngod",{"type":17,"tag":33,"props":329,"children":330},{},[331,333,336],{"type":24,"value":332},"oh.",{"type":17,"tag":39,"props":334,"children":335},{},[],{"type":24,"value":337},"\ngod.",{"type":17,"tag":33,"props":339,"children":340},{},[341],{"type":24,"value":342},"oh-",{"type":17,"tag":33,"props":344,"children":345},{},[346,348,351],{"type":24,"value":347},"okay,",{"type":17,"tag":39,"props":349,"children":350},{},[],{"type":24,"value":352},"\nstop!",{"type":17,"tag":33,"props":354,"children":355},{},[356,358,361],{"type":24,"value":357},"breathe.",{"type":17,"tag":39,"props":359,"children":360},{},[],{"type":24,"value":362},"\nf