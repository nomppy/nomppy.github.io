pe":24,"value":461},"you, who drew me down",{"type":17,"tag":39,"props":463,"children":464},{},[],{"type":24,"value":466},"\nand held me like a note as well,",{"type":17,"tag":33,"props":468,"children":469},{},[470],{"type":24,"value":471},"who made all the flowers swell, remorse",{"type":17,"tag":33,"props":473,"children":474},{},[475,477,480,482,485],{"type":24,"value":476},"you were everyone, Morse,",{"type":17,"tag":39,"props":478,"children":479},{},[],{"type":24,"value":481},"\nhave you texted me to",{"type":17,"tag":39,"props":483,"children":484},{},[],{"type":24,"value":486},"\ntell me why you didn’t call but leapt instead,",{"type":17,"tag":33,"props":488,"children":489},{},[490],{"type":24,"value":491},"I guess I didn’t know you well,",{"type":17,"tag":33,"props":493,"children":494},{},[495,497,500,502,505],{"type":24,"value":496},"from your possibly proverbial balcony into the air,",{"type":17,"tag":39,"props":498,"children":499},{},[],{"type":24,"value":501},"\nI mean is it fair,",{"type":17,"tag":39,"props":503,"children":504},{},[],{"type":24,"value":506},"\nthat you are gone and I am still around,",{"type":17,"tag":33,"props":508,"children":509},{},[510],{"type":24,"value":511},"and why does everything keep making that fucking sound.",{"type":17,"tag":513,"props":514,"children":515},"hr",{},[],{"type":17,"tag":517,"props":518,"children":519},"email-sub",{},[520],{"type":17,"tag":33,"props":521,"children":523},{"style":522},"text-align: left",[524],{"type":24,"value":525},"\nSpecial thanks to the many people who helped revise this poem, particularly my classmates in English 324.\nIf you liked this poem, consider signing up to get new ones (and prose) mailed to you:\n",{"title":7,"searchDepth":527,"depth":527,"links":528},2,[529],{"id":29,"depth":530,"text":8},3,"markdown","content:posts:morse.md","content","posts/morse.md","md",1777178870770]