[{"data":1,"prerenderedAt":216},["Reactive",2],{"content-query-MKy2JaMXF9":3},{"_path":4,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":8,"description":6,"category":9,"status":10,"start":11,"end":12,"body":13,"_type":211,"_id":212,"_source":213,"_file":214,"_extension":215},"/posts/holding-cell","posts",false,"","Half Past Midnight In My Holding Cell","poetry","finished","2022-09-04T00:00:00.000Z","2022-11-07T00:00:00.000Z",{"type":14,"children":15,"toc":206},"root",[16,24,50,76,104,124,144,164,184],{"type":17,"tag":18,"props":19,"children":21},"element","h3",{"id":20},"half-past-midnight-in-my-holding-cell",[22],{"type":23,"value":8},"text",{"type":17,"tag":25,"props":26,"children":27},"p",{},[28,34,38,40,43,45,48],{"type":17,"tag":29,"props":30,"children":31},"em",{},[32],{"type":23,"value":33},"Do it.",{"type":17,"tag":35,"props":36,"children":37},"br",{},[],{"type":23,"value":39},"\nMy hands tremble.",{"type":17,"tag":35,"props":41,"children":42},{},[],{"type":23,"value":44},"\nThe razor clatters to the ground.",{"type":17,"tag":35,"props":46,"children":47},{},[],{"type":23,"value":49},"\nHe begs for mercy.",{"type":17,"tag":25,"props":51,"children":52},{},[53,55,58,63,66,68,71],{"type":23,"value":54},"My hands are trembling.",{"type":17,"tag":35,"props":56,"children":57},{},[],{"type":17,"tag":29,"props":59,"children":60},{},[61],{"type":23,"value":62},"Don't hesitate. Make it quick.",{"type":17,"tag":35,"props":64,"children":65},{},[],{"type":23,"value":67},"\nHe's begging for mercy.",{"type":17,"tag":35,"props":69,"children":70},{},[],{"type":17,"tag":29,"props":72,"children":73},{},[74],{"type":23,"value":75},"Please, don't kill me.",{"type":17,"tag":25,"props":77,"children":78},{},[79,81,86,89,91,94,99,102],{"type":23,"value":80},"I hesitate — ",{"type":17,"tag":29,"props":82,"children":83},{},[84],{"type":23,"value":85},"make it quick!",{"type":17,"tag":35,"props":87,"children":88},{},[],{"type":23,"value":90},"\nI close the door.",{"type":17,"tag":35,"props":92,"children":93},{},[],{"type":17,"tag":29,"props":95,"children":96},{},[97],{"type":23,"value":98},"Please don't kill me. I have a family.",{"type":17,"tag":35,"props":100,"children":101},{},[],{"type":23,"value":103},"\nI feel the cold blade between my fingers.",{"type":17,"tag":25,"props":105,"children":106},{},[107,109,112,114,117,119,122],{"type":23,"value":108},"I shut the bathroom door",{"type":17,"tag":35,"props":110,"children":111},{},[],{"type":23,"value":113},"\nover his calls for help.",{"type":17,"tag":35,"props":115,"children":116},{},[],{"type":23,"value":118},"\nI feel the razor's graze, its icy gleam cuts",{"type":17,"tag":35,"props":120,"children":121},{},[],{"type":23,"value":123},"\nhow a lullaby cuts through nightmares.",{"type":17,"tag":25,"props":125,"children":126},{},[127,129,132,134,137,139,142],{"type":23,"value":128},"He's tried calling out for help.",{"type":17,"tag":35,"props":130,"children":131},{},[],{"type":23,"value":133},"\nHe's done everything he could.",{"type":17,"tag":35,"props":135,"children":136},{},[],{"type":23,"value":138},"\nI sing him a lullaby",{"type":17,"tag":35,"props":140,"children":141},{},[],{"type":23,"value":143},"\nto quiet his fears.",{"type":17,"tag":25,"props":145,"children":146},{},[147,149,152,154,157,159,162],{"type":23,"value":148},"I'm doing everything I can",{"type":17,"tag":35,"props":150,"children":151},{},[],{"type":23,"value":153},"\nto make it painless for myself.",{"type":17,"tag":35,"props":155,"children":156},{},[],{"type":23,"value":158},"\nI quiet my fears. I silence my doubts.",{"type":17,"tag":35,"props":160,"children":161},{},[],{"type":23,"value":163},"\nI forget all those I've ever cared about.",{"type":17,"tag":25,"props":165,"children":166},{},[167,169,172,174,177,179,182],{"type":23,"value":168},"To make it easy and painless for myself,",{"type":17,"tag":35,"props":170,"children":171},{},[],{"type":23,"value":173},"\nI pretend I'm executing someone else.",{"type":17,"tag":35,"props":175,"children":176},{},[],{"type":23,"value":178},"\nNot anyone I've ever cared about,",{"type":17,"tag":35,"props":180,"children":181},{},[],{"type":23,"value":183},"\njust a stranger and nobody else.",{"type":17,"tag":25,"props":185,"children":186},{},[187,189,192,196,199,201,204],{"type":23,"value":188},"I pretend to execute someone else.",{"type":17,"tag":35,"props":190,"children":191},{},[],{"type":17,"tag":29,"props":193,"children":194},{},[195],{"type":23,"value":33},{"type":17,"tag":35,"props":197,"children":198},{},[],{"type":23,"value":200},"\nJust a stranger and nobody else.",{"type":17,"tag":35,"props":202,"children":203},{},[],{"type":23,"value":205},"\nMy razor clatters to the ground.",{"title":7,"searchDepth":207,"depth":207,"links":208},2,[209],{"id":20,"depth":210,"text":8},3,"markdown","content:posts:holding-cell.md","content","posts/holding-cell.md","md",1777178870778]